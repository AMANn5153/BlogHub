{
  "compilerOptions": {
    "jsx": "react-jsx", 
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"] // Adjust this based on your project structure
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}